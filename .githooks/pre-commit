#!/bin/sh
# Blocks commits that contain credentials or organizer data files.
staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0
if echo "$staged" | grep -Eiq '\.(pdf|csv|parquet|pkl)$|(^|/)\.env$'; then
  echo "pre-commit: data/PDF/.env files are not allowed in this public repo." >&2; exit 1
fi
if git diff --cached -U0 | grep -Eq '^\+.*(AKIA[0-9A-Z]{16}|dapi[0-9a-f]{32}|sk-ant-[A-Za-z0-9_-]{10,})'; then
  echo "pre-commit: possible secret detected in staged changes." >&2; exit 1
fi
# Optional machine-local checks (not versioned).
local_hook="$(git rev-parse --git-dir)/hooks/pre-commit.local"
[ -x "$local_hook" ] && exec "$local_hook"
exit 0
