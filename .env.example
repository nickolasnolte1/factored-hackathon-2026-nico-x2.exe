# Copy to .env (git-ignored) and fill in locally. Never commit real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2
DATATHON_BUCKET=
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# Bank tool service (mock). DEV ONLY placeholders: replace them for any shared demo, never commit real values.
BANK_TOOLS_ENV=dev
BANK_TOOLS_SESSION_KEY=dev-only-change-me-session-signing-key-000000
BANK_TOOLS_OTP_KEY=dev-only-change-me-otp-hash-key-0000000000000
BANK_TOOLS_REPOSITORY=local
BANK_TOOLS_SNAPSHOT=data/bank_tools/snapshot_panel.sqlite
BANK_TOOLS_CLOCK=2026-06-19T09:00:00
DATABRICKS_WAREHOUSE_ID=
# Optional (empty = default, see src/bank_tools/CONTRACT.md section 11)
BANK_TOOLS_SESSION_KEY_PREVIOUS=
BANK_TOOLS_STATE_PATH=
BANK_TOOLS_CONFIRMATION_TTL_S=600
BANK_TOOLS_MODEL_AUTH=false
BANK_TOOLS_READ_ONLY=false
BANK_TOOLS_AUDIT_DIR=data/bank_tools/audit
BANK_TOOLS_AUDIT_RETENTION_DAYS=30
BANK_TOOLS_OTP_OUTBOX_FILE=
BANK_TOOLS_CATALOG=workspace
BANK_TOOLS_GOLD_SCHEMA=gold
BANK_TOOLS_OPS_SCHEMA=ops
DATABRICKS_CONFIG_PROFILE=
DATABRICKS_CLI=
# Test only: 1 runs the live Databricks acceptance tests in tests/bank_tools
BANK_TOOLS_TEST_DATABRICKS=0
